{
  "pluginName": "小沈笔记",
  "description": "现代化 Markdown 编辑器：实时预览、分屏、专注模式；支持 GitHub / Gitee / 本地仓库 Git 同步",
  "version": "1.3.2",
  "logo": "logo.png",
  "main": "index.html",
  "preload": "preload.js",
  "development": {
    "main": "http://localhost:5173",
    "preload": "preload.js"
  },
  "features": [
    {
      "code": "open-editor",
      "cmds": ["md", "随心记", "小沈笔记", "笔记"],
      "explain": "现代化 Markdown 编辑器：实时预览、双屏、专注模式，支持备份与多格式导出"
    }
  ],
  "tools": {
    "markdown_notes_search": {
      "description": "搜索 Markdown 笔记内容",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "markdown_notes_get": {
      "description": "读取指定 Markdown 笔记",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "markdown_notes_create": {
      "description": "新建 Markdown 笔记",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    "markdown_render": {
      "description": "将 Markdown 渲染为图片或 PDF",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  },
  "platform": ["win32", "darwin", "linux"],
  "name": "mindnote",
  "author": "南城旧梦",
  "homepage": null
}
